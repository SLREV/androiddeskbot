# ── Grok Bot · pump.fun night mode ──────────────────────────────────────
# Salin ke .env lalu isi (opsional — default sudah jalan mode demo/paper).

# server
DESK_BIND=127.0.0.1
DESK_PORT=8788
DESK_DATA_DIR=.

# feed & eksekusi
DESK_MODE=demo                  # demo | live
DESK_EXECUTION_MODE=paper       # paper | live
GMGN_API_KEY=                   # kosongkan → mock feed (demo)
GMGN_BASE_URL=https://api.gmgn.ai

# session envelope (dialog "Connect pump.fun")
SESSION_START=22:15
SESSION_END=08:15
SESSION_BUDGET_USD=95
MAX_TRADE_PCT=10                # maks % budget per trade

# risk per posisi
TAKE_PCT=25                     # take-profit
STOP_PCT=6                      # hard stop / trail distance

# consensus core ("nothing gets bought unless they agree")
CONSENSUS_MIN=6                 # minimal 6 dari 8 agent setuju
CYCLE_SECS=20

# live trading (WAJIB diisi sebelum DESK_EXECUTION_MODE=live)
LIVE_TRADE_ENDPOINT=            # trade-builder API (mengembalikan tx unsigned)
LIVE_RPC_ENDPOINT=              # RPC Solana untuk sendTransaction (mis. https://api.mainnet-beta.solana.com)
LIVE_WALLET_PUBKEY=             # public key wallet sesi (base58)
LIVE_WALLET_KEYFILE=            # file keypair Solana CLI (JSON 64 angka) — ATAU pakai baris berikut
LIVE_WALLET_SEED_B64=           # alternatif: seed 32-byte dalam base64
# catatan: penandatanganan dilakukan LOKAL (ed25519) — private key tidak pernah
# dikirim ke trade-builder/RPC pihak ketiga. Cek kesiapan: ./grokbot --doctor
